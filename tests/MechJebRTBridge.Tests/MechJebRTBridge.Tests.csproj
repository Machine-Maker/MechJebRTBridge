<Project Sdk="Microsoft.NET.Sdk">

  <!-- In-game test harness for the bridge. Dev-only: never part of the release zip.
       Builds to tests/MechJebRTBridge.Tests/GameData/MechJebRTBridge.Tests/Plugins/ (gitignored)
       and, via Directory.Build.targets, into $(KSPBT_GameRoot)/GameData/MechJebRTBridge.Tests/Plugins/.
       See tests/README.md. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MechJebRTBridge.Tests</RootNamespace>
    <AssemblyName>MechJebRTBridge.Tests</AssemblyName>
    <LangVersion>8</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Overrides the repo-wide Directory.Build.props value, which points at the release
         packaging folder. The test DLL must never land in GameData/MechJebRTBridge/. -->
    <KSPBT_ModRoot>$(MSBuildThisFileDirectory)GameData/MechJebRTBridge.Tests/</KSPBT_ModRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <!-- No reference to MechJebRTBridge itself: the tests are black-box. They drive MechJeb the
       way a click (or an autopilot) would, and observe RemoteTech's queue, MechJeb's module
       state, and the bridge's [MJ-RT Bridge] log lines. -->
  <ItemGroup>
    <ModReference Include="MechJeb2">
      <DLLPath>GameData/MechJeb2/Plugins/MechJeb2.dll</DLLPath>
      <CKANIdentifier>MechJeb2</CKANIdentifier>
    </ModReference>
    <ModReference Include="RemoteTech">
      <DLLPath>GameData/RemoteTech/Plugins/RemoteTech.dll</DLLPath>
      <CKANIdentifier>RemoteTech</CKANIdentifier>
    </ModReference>
    <ModReference Include="0Harmony">
      <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
      <CKANIdentifier>Harmony2</CKANIdentifier>
    </ModReference>
  </ItemGroup>

</Project>
